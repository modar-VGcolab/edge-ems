# Copy to .env (git-ignored) and fill in. Loaded by docker compose via env_file.
SITE_ID=vgcolab-01
INFLUX_TOKEN=lvTfpe6JT901RWyFxhjCbkzcYzMpbXtdou_TdE60r2GLAHoq6kpOMxGsFhvUemstA0scpxnhaeGf906TqKjVgw==   # local dev; use a long random string for anything real
INFLUX_ORG=edge
INFLUX_BUCKET=edge_ems
MQTT_USERNAME=
MQTT_PASSWORD=

# Controller HTTP API auth (KNOWN_ISSUES #4). Empty/unset = auth OFF (today's
# behavior; fine for an isolated bench). Set a long random value for any
# deployment reachable from more than that -- both the controller (which
# checks it) and the ext-ems gateway (which sends it to /setpoint) read this
# same var via env_file, so one value here covers both.
CONTROLLER_API_TOKEN=

# --- which configs core/controller load (optional overrides) ----------------
# Defaults are the SIL configs (token hardcoded 'change-me' for local sims).
# To run the real services profile with the real INFLUX_TOKEN above, point these
# at the example configs (the loaders now expand ${INFLUX_TOKEN} from this env):
#   EMS_CONFIG_PATH=configs/edge_ems_config.example.yaml
#   ASSET_CONFIG_PATH=configs/asset_config.example.yaml   # uses real device IPs
# Run compose with --env-file configs/.env so the InfluxDB admin token and the
# app's token come from the SAME file:
#   docker compose --env-file configs/.env -f deploy/docker-compose.yml up -d
